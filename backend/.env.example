PORT=3333
NODE_ENV=development
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGIN=http://localhost:5173

# Bunny Stream (upload/encoding de vídeo de aula) — opcionais: o app sobe sem elas, só as rotas
# de vídeo (POST /api/aulas/:id/video e o webhook) respondem 503/401 até serem preenchidas.
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
# Segredo usado para autenticar o webhook de encoding da Bunny — ver comentário em
# src/routes/webhooks.ts sobre como ele é validado (a Bunny não suporta header de assinatura,
# então o segredo vai na própria URL do webhook cadastrada no painel da Bunny).
BUNNY_WEBHOOK_SECRET=

# Resend (envio de e-mail de convites) — opcionais: o app sobe sem elas, e os links de convite
# são apenas registrados no log do servidor (útil para testes locais).
RESEND_API_KEY=
EMAIL_REMETENTE=

# URL do frontend para montar links de convite em e-mails. Default: http://localhost:5173
FRONTEND_URL=
